# Development only. Vite loads this file for `npm run dev` (mode
# development); production builds do NOT read it, so this localhost
# URL can never leak into a deployed build. Production uses the
# VITE_API_URL environment variable set in the hosting dashboard
# (see .env.production.example). No secrets belong in any frontend
# env file — the only frontend env var is this backend URL.
VITE_API_URL=http://localhost:8000
