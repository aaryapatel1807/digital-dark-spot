# Frontend-only config. No secrets belong here — ever.
# The only frontend env var is the backend URL (an origin, not a key).
#
# Development: `npm run dev` reads frontend/.env.development
# (http://localhost:8000), so you do not need this file locally.
# Production: set VITE_API_URL in the hosting dashboard (Vercel >
# Project > Settings > Environment Variables) BEFORE building —
# Vite bakes it into the bundle, so changing it requires a redeploy.
# See frontend/.env.production.example for the exact format:
# backend origin only, no path, no trailing slash.
VITE_API_URL=http://localhost:8000
