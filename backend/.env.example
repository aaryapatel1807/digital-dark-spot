# Copy to backend/.env (gitignored). See ../README.md "Deployment (free hosting)".
# Keys are backend-only: the frontend never receives them (health
# reports only groq_configured: true/false). NEVER commit a real .env.
#
# Optional free Groq key (https://console.groq.com). Leave blank and
# the API runs in honest offline sample mode (deterministic engine).
GROQ_API_KEY=<redacted>
# Optional model name, used only to propose questions when none are supplied.
GROQ_MODEL=
# Comma-separated origins allowed to call the API. Local defaults
# cover Vite dev (5173) and vite preview (4173).
# PRODUCTION: replace with the exact deployed frontend origin —
# scheme + host only, no path, no trailing slash, e.g.
# CORS_ORIGINS=https://gaplens-xyz.vercel.app
# Never use * in production, and never paste a dashboard URL here
# (a Vercel dashboard URL with a path is not a valid Origin).
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# development | production (reported by /api/health)
ENVIRONMENT=development
