# GapLens — backend configuration. Copy to backend/.env and fill in.
# This mirrors backend/.env.example; keep the two in sync.
# NEVER commit a real backend/.env. Keys are backend-only: the frontend
# never receives them (health reports only groq_configured: true/false).
# Leave GROQ_API_KEY blank to run in honest offline sample mode.

# Optional free Groq key (https://console.groq.com). Not required.
GROQ_API_KEY=<redacted>
# Optional model name, used only to propose questions when none are supplied.
GROQ_MODEL=
# Comma-separated origins allowed to call the API. Local defaults
# cover Vite dev (5173) and vite preview (4173).
# PRODUCTION: the exact deployed frontend origin, scheme + host only,
# no path, no trailing slash (see README "Deployment (free hosting)").
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
# development | production
ENVIRONMENT=development
