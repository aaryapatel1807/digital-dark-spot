# GapLens — backend configuration. Copy to backend/.env and fill in.
# NEVER commit a real backend/.env. Keys are backend-only: the frontend
# never receives them (health reports only groq_configured: true/false).
# Leave GROQ_API_KEY blank to run in honest offline sample mode.

# Optional free Groq key (https://console.groq.com). Not required for this foundation.
GROQ_API_KEY=
# Optional model name, used only once the analysis layer is built.
GROQ_MODEL=
# Comma-separated origins allowed to call the API. Default covers local Vite.
CORS_ORIGINS=http://localhost:5173
# development | production
ENVIRONMENT=development
